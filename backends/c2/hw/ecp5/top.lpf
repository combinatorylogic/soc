BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
LOCATE COMP "RX" SITE "C11";
IOBUF PORT "RX" IO_TYPE=LVCMOS33;
LOCATE COMP "TX" SITE "A11";
IOBUF PORT "TX" IO_TYPE=LVCMOS33;
LOCATE COMP "sys_clk_in" SITE "P3";
IOBUF PORT "sys_clk_in" IO_TYPE=LVDS;
LOCATE COMP "sys_reset" SITE "T1";
IOBUF PORT "sys_reset" IO_TYPE=LVCMOS33;
FREQUENCY PORT "sys_clk_in" 100.0 MHz;
FREQUENCY PORT "clk" 50.0 MHz;
