% literate:


\section{A dirty hack in an absense of our own CLP(FD) engine}

N.B.: this engine may infer longer delays for the "after" rules. The output requires
an additional post-processing step which may insert proxy variables for such unfortunate cases.

\pfcode{
ast clpfd0 recform {
   expr = after(var:a, var:b, number:n)
        | depends(var:a, var:b)
        | ordered(var:a, var:b)
        | exclusive(var:a, var:b)
        | entry(var:a)
        ;
   code = c(.*expr:es);
}}

\pfcode{
function printeqs_clpfd(c)
   visit:clpfd0 /rec/ (code: c) {
     deep code { c -> strinterleave(es,",\n   ") };
     deep expr {
        after -> %S<<("after(",a,",",b,",",n,")")
      | depends -> %S<<("depends(",a,",",b,")")
      | ordered -> %S<<("ordered(",a,",",b,")")
      | exclusive -> %S<<("exclusive(",a,",",b,")")
      | entry -> %S<<("  ",a,"  #=  0")}}}

\pfcode{
function pprint_clpfd(c, pipelined) {
   getvars(c) = {
      ht = mkhash();
      visit:clpfd0 /rec/ (code: c) {
         once var: ohashput(ht, thisnodesrc(), 1)};
      return hashmap(fun(k,v) k, ht)};
   vars = getvars(c);
   svars = map v in vars do %S<<(v);
   svarslist = strinterleave(svars, ", ");
   // Accesses to one memory are strictly ordered, so a block with N operations may need up to
   // about N stages; a fixed 0..100 domain made the goal fail for long straight-line blocks.
   bound = 100 + 2 * length(vars);
   inner = %S<<(
      "generate(Vars) :- \n",
      "   Vars = [", svarslist, "], \n",
      "   [", svarslist, "] ins 0..", bound, ",\n",
      printeqs_clpfd(c),
      ",labeling([",
         strinterleave(map v in vars do %S<<("min(",v,")"), ","),
      "], [", svarslist, "]).\n");

   // A pipeline stage lasts exactly one step and a RAM's output or an operator's result is only
   // present for that step, so commits must land exactly where the latency says; an FSM may wait.
   afterrule = if (pipelined) {
      "after(A, B, N) :- A #= B + N.
"} else {
      "after(A, B, N) :- A #>= B + N.
"};
   outer = %S<<(":- use_module(library(clpfd)).

", afterrule, "depends(A, B) :- A #>= B.
ordered(A, B) :- A #> B.
exclusive(A, B) :- dif(A, B).
");
   footer = "?- generate(Vars), print(Vars), halt(0).";

   return vars:%S<<(outer, inner, footer)
}}

\pfcode{
parser clpfdout (pfront) {
   !!Spaces;
   clpfdout := "[" ecslist<[number],",">:es "]" [Spaces]* => es;}}

\pfcode{
#(define hls_sched_pid
   (let* ((tproc (sdotnet "System.Diagnostics.Process"))
          (curproc (fun () ((r_sbind tproc "GetCurrentProcess")))))
     (fun () ((r_bind tproc "get_Id") (curproc)))))
}

\pfcode{
function run_clpfd(c0, pipelined)
if(c0) {
    tmp(s) = %ast2:from-listform(clpfd0, code, s);
    c = tmp('c'(@c0));
   <vars:code> = pprint_clpfd(c, pipelined);
    // One file per compiler process: concurrent compiles in one directory used to read each
    // other's schedules through a shared tmpfile.pl, which silently produced wrong FSMs.
    fname = %S<<("hls_sched_", hls_sched_pid(), ".pl");
    %call-with-output-file(fname, fun(f) fprintln(f, code));
    collector(add, get) {
       system("swipl", %S<<("-s ", fname), add);
       system("rm", %S<<("-f ", fname), fun(x) []);
       l = car(lasttail(get()));
       res = parse l as clpfdout;
       // A failed goal leaves a warning as the last line, which used to be zipped with the
       // variables and surface much later as a cast error in the stage arithmetic.
       if ((length(res) < length(vars)) || (length(res) > length(vars)))
          ccerror('HLS-SCHEDULE-FAILED'(%S<<("swipl output: ", l)));
       return zip(vars, res)}}}

%%%