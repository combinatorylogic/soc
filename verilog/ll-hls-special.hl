% literate:


\subsection{Special blocks expansion}


\pfcode{

syntax in expr, start:
  'xsymbols "(" cslist<[mdqvarident],",">:args ")" [expr]:body'
{
   ('begin':(map a in args do {
               sa = 'var'(cadr(a));
               `::varid \a\ = egensym(\sa\)`})) :: [body]
}

#(macro egensym (id) `(efgensym ',id))

#(function efgensym (id) (Sm<< id "_" (gensym)))

}


This one is horrible, it clearly need to be broken into few smaller stages instead.

\pfcode{
function ll_to_hls_extend_outputs(top) {
   rdepth = mkref(1); rwdepth = mkref(1);
   getdepth() =
     visit:hls2 /rec/ (top: top) {
       once specentry {
          enqueue_once -> {
             rdepth := depth}
       |  enqueue_loop -> {
             if (onecyclep) rwdepth := 1 else rwdepth := depth;
             rdepth := depth}
       |  else -> []}};
   getdepth();
   outputs = mkhash();
   depth = ^rdepth;
   wdepth = ^rwdepth;
   getwidth(t) =
      visit:hls2 /rec/ (type: t) {
         once type { v -> bits }};
   outputs:
       visit:hls2 /rec/ (top: top) {
         deep top {
           module -> {
             ll_hls_md_register_depth(nm, depth);
             ll_hls_md_register_args(nm, args);
             node()
           }
         | else -> node()
         };
         once modentry {
           register -> {  // repeats aout
             aif(chk = ohashget(outputs, nm)) {
               mk:node(t = mk:v(chk * wdepth))
             } else node()}
         | else -> node()};
         once modarg {
            aout -> if (ohashget(^ll_hls_ram_outputs, nm)) node() else {
              w = getwidth(tp);
              ohashput(outputs, nm, w);
              mk:node(tp = mk:v(w * wdepth))}
         |  aoutreg -> if (nm === 'ACK') node() else {
              w = getwidth(tp);
              ohashput(outputs, nm, w);
              mk:node(tp = mk:v(w * wdepth))}
         |  else -> node()}}
   }}


\pfcode{
function ll_to_hls_unroll_enqueue_loop(addentry, outputs, ee, onecyclep) {
   getreg(v) =
      visit:hls2 /rec/ (value: v) {
        once value {
          reg -> id
        | else -> ccerror('NOPE'())}};
   visit:hls2 /rec, dst hls3/ (specentry: ee) {
      deep reissuereg {
         r -> [nm;tp;init;step]};
      deep specentry {
        enqueue_loop -> xsymbols (isidle, isentry, thrcount, livecnt, thrlive, loopexitcnd, isoutput,
                                  fresh, issued, nextid, thridexit) {
           // Batch mode (hls_pipeline_loop_batch): `count` threads per request, a slot that has
           // finished its thread is refilled with the next one on its next visit; count 0 is the
           // classic behaviour, one round of depth threads.
           batchp = visit:hls2 /rec/ (value: count) {
              once value { const -> if (v == 0) [] else true | else -> true }};
           i32t = mk:type:v(32);
           // Dispatcher mode (the loop sits in a branch of the entry FSM): request and acknowledge
           // are registers shared with that FSM, and results leave through RAM stores only.
           dispatchp = not(id === 'default');
           reqname = if (dispatchp) %Sm<<(pipeline, "_req") else 'REQ';
           ackname = if (dispatchp) %Sm<<(pipeline, "_ack") else 'ACK';
           activename = %Sm<<(pipeline, "_active");
           advname = %Sm<<(pipeline, "_advance");
           ii = aif(chk = ohashget(^ll_hls_pipe_ii_of, pipeline)) chk else 1;
           if (dispatchp) addentry(mk:modentry:register(mk:v(1), ackname));
           addentry(mk:modentry:wire(mk:v(1), activename));
           addentry(mk:modentry:assign(activename, mk:e(mk:op('NOT', [mk:reg(isidle)], mk:v(1)))));
           lastlivenm = %Sm<<(thrlive, "_", depth - 1);
           freshsel = if (batchp) mk:value:reg(fresh) else mk:value:reg(isentry);
           // Loop control FSM generation:
           // 1. IDLE stage - zero all the registers. If REQ, set INIT=1 and go to LOOP stage
           // 2. LOOP:
           //    N times, increment the thread counter, set the initial registers (either to
           //    the initial values if INIT==1 or to the step values);
           //
           //    If loop exit condition == 1 and thread is alive, set thread live register = 0,
           //      otherwise set it to 1.
           //    Count all live threads.
           //    If there are no more threads alive, set ACK = 1
           //
           //    If INIT==0, accumulate the output (execute the exit instructions, transformed to accomodate
           //     the output vector construction)
           //
           //    For the final Nth step, set INIT=0.

           // Some checks first:
           if (stepinstrs) ccerror('BEHAVIORAL-IN-LOOP-ENTRY'());

           enqueue_reset = mk:stmt:begin([
              mk:set(isidle, mk:v(mk:const(1, mk:v(1))))]);

           // Assign loop registers to their next values
           renamesht = mkhash();
           iter [d;[s;t]] in zip(exit_dst, zip(exit_src, exit_type)) do {
              dn = getreg(d); sn = getreg(s);
              addentry(mk:modentry:wire(t, dn));
              addentry(mk:modentry:assign(dn, mk:reg(sn)));
              ohashput(renamesht, dn, sn)};
           renamereg(v) =
              visit:hls2 /rec, dst hls3/ (value: v) {
                once value {
                  reg -> aif(chk = ohashget(renamesht, id)) mk:reg(id=chk) else node()
                | else -> node()}};

           rregsht = mkhash();
           loopregs = map append [nm;tp;init;step] in rregs do {
              nextnm = nm;
              ohashput(rregsht, nm, nextnm);
              addentry(mk:modentry:wire(tp, nextnm));
              addentry(mk:modentry:assign(nextnm,
                mk:e(
                  mk:select(freshsel,
                            renamereg(init), // No need to rename it, really
                            renamereg(step)))));
              return []
           };
           if (batchp) {
              addentry(mk:modentry:wire(mk:v(1), fresh));
              addentry(mk:modentry:register(i32t, issued));
              addentry(mk:modentry:register(i32t, nextid));
              // Gated on the FSM being out of idle: an idle pipeline still sees the shared count
              // input (another kernel's request), and isentry is held at one in idle, so without
              // the gate phantom threads enter the liveness shift register and later store.
              addentry(mk:modentry:assign(fresh,
                 mk:e(mk:op('And', [
                    mk:e(mk:op('NOT', [mk:reg(isidle)], mk:v(1)));
                    mk:e(mk:op('And', [
                       mk:e(mk:op('SLT', [mk:reg(issued); count], mk:v(1)));
                       mk:e(mk:op('Or', [mk:reg(isentry);
                                         mk:e(mk:op('NOT', [mk:reg(lastlivenm)], mk:v(1)))], mk:v(1)))],
                       mk:v(1)))],
                    mk:v(1)))))};
           
           // Increment thread counter, threadId, live count
           inccounter = { // Thread counter just cycles in 1 .. N continuously
              nextnm = %Sm<<(thrcount, "_next");
              addentry(mk:modentry:register(mk:v(depth), thrcount));
              addentry(mk:modentry:wire(mk:v(depth), nextnm));
              addentry(mk:modentry:assign(nextnm,
                 mk:e(
                   mk:op('compose',[mk:e(mk:op('range', [mk:reg(thrcount);
                                                         mk:const(depth-2,mk:v(32));
                                                         mk:const(0,mk:v(32))], mk:v(depth-1)));
                                    mk:e(mk:op('range', [mk:reg(thrcount);
                                                         mk:const(depth-1,mk:v(32));
                                                         mk:const(depth-1,mk:v(32))], mk:v(1)))],
                                    mk:v(depth)))));
              [mk:stmt:set(thrcount, mk:v(mk:reg(nextnm)))]};
           idname = getreg(thrid);
           addentry(mk:modentry:wire(mk:v(32), thridexit));
           incthrid = if (batchp) {
              // The slot's thread id travels with the slot: a shift register of depth entries,
              // fed with the fresh id or the returning one; the pipeline reads the current value.
              tregs = map i in [0..depth] do %Sm<<(idname, "_slot_", i);
              iter t in tregs do addentry(mk:modentry:register(mk:v(32), t));
              tidlast = car(reverse(tregs));
              addentry(mk:modentry:wire(mk:v(32), idname));
              addentry(mk:modentry:assign(idname,
                 mk:e(mk:select(mk:reg(fresh), mk:reg(nextid), mk:reg(tidlast)))));
              addentry(mk:modentry:assign(thridexit, mk:reg(tidlast)));
              [@collector(add, get) {
                  foldl(fun(l, r) { add(mk:stmt:set(r, mk:v(mk:reg(l)))); r }, idname, tregs);
                  get()};
               mk:stmt:if(mk:v(mk:reg(fresh)),
                          mk:begin([mk:set(nextid, mk:v(mk:e(mk:op('Add', [mk:reg(nextid); step], mk:v(32)))));
                                    mk:set(issued, mk:v(mk:e(mk:op('Add', [mk:reg(issued); mk:const(1, i32t)], mk:v(32)))))]),
                          mk:begin([mk:nop()]))]
           } else { // ThrId increments the same way as with the simple pipeline. TODO: TYPE!!!
              nextnm = %Sm<<(idname, "_next");
              addentry(mk:modentry:register(mk:v(32), idname)); // TODO: type!
              addentry(mk:modentry:wire(mk:v(32), nextnm));
              addentry(mk:modentry:assign(nextnm,
                 mk:e(
                   mk:select(mk:e(mk:op('NOT', [
                                     mk:e(mk:op('range', [
                                        mk:reg(thrcount);
                                        mk:const(depth-1, mk:v(32));
                                        mk:const(depth-1, mk:v(32))
                                     ], mk:v(1)))], mk:v(1))),
                      mk:e(mk:op('Add', [mk:reg(idname); step], mk:v(32))),
                      thrinit))));
              addentry(mk:modentry:assign(thridexit, mk:reg(idname)));
              [mk:stmt:set(idname, mk:v(mk:reg(nextnm)))]};
           inclive = { // Live counter contains a number of threads issued/reissued at this iteration
              nextnm = %Sm<<(livecnt, "_next");
              addentry(mk:modentry:register(mk:v(depth), livecnt));
              addentry(mk:modentry:wire(mk:v(depth), nextnm));
              addentry(mk:modentry:assign(nextnm,
                 mk:e(
                   mk:select(mk:e(mk:op('NOT', [
                                     mk:e(mk:op('range', [
                                        mk:reg(thrcount);
                                        mk:const(depth-1, mk:v(32));
                                        mk:const(depth-1, mk:v(32))
                                     ], mk:v(1)))], mk:v(1))),
                      mk:e(mk:op('compose',[mk:e(mk:op('range', [mk:reg(livecnt);
                                                         mk:const(depth-2,mk:v(32));
                                                         mk:const(0,mk:v(32))], mk:v(depth-1)));
                                            mk:reg(thrlive)], mk:v(depth))),
                      mk:const(0, mk:v(32))))));
              [mk:stmt:set(livecnt, mk:v(mk:reg(nextnm)))]};

           increments = [@inccounter;
                         @incthrid;
                         @inclive];
           checkexit = { // Set the live status wire for the thread being currently issued/re-issued
              // While we're at it, emit the live status pipeline:
              lregs = map i in [0..depth] do {
                 %Sm<<(thrlive, "_", i)
              };
              iter l in lregs do
                addentry(mk:modentry:register(mk:v(1), l));
              addentry(mk:modentry:wire(mk:v(1), thrlive));
              liveshift() =
                 mk:stmt:begin(
                     collector(add, get) {
                      foldl(fun(l, r) {
                               add(mk:stmt:set(r, mk:v(mk:reg(l)))); r}, thrlive, lregs);
                      get()});
              // The live status moves with the pipeline: only on the last sub-cycle when ii > 1.
              gatedshift() =
                 if (ii > 1) {
                    mk:stmt:if(mk:v(mk:reg(advname)), liveshift(), mk:stmt:begin([mk:stmt:nop()]))
                 } else { liveshift() };
              addentry(mk:modentry:always(
                 mk:if(mk:op('NOT',[mk:reg('reset')], mk:v(32)),
                    mk:begin(
                      map l in lregs do mk:stmt:set(l, mk:v(mk:const(0, mk:v(1))))),
                    gatedshift())));
              lastlive = car(reverse(lregs));
              // Now, check the exit condition and a previous live status if needed.
              // Thread is live if:
              //   - it's an entry loop and exit condition holds
              //   - or, the previous iteration was alive and the exit condition holds
              negloopexitcnd = %Sm<<(loopexitcnd, "_not");
              addentry(mk:modentry:assign(thrlive,
                mk:e(
                   mk:select(freshsel,
                             mk:reg(negloopexitcnd),
                             mk:e(mk:select(mk:reg(lastlive),
                                       mk:reg(negloopexitcnd),
                                       mk:const(0, mk:v(1))))))));
              // Emit isoutput
              addentry(mk:modentry:wire(mk:v(1), negloopexitcnd));
              addentry(mk:modentry:assign(negloopexitcnd,
                  mk:e(mk:op('NOT', [mk:reg(loopexitcnd)], mk:v(1)))));
              addentry(mk:modentry:wire(mk:v(1), isoutput));
              addentry(mk:modentry:assign(isoutput,
                mk:e(
                   mk:select(freshsel,
                             mk:reg(loopexitcnd),
                             mk:e(mk:select(mk:reg(lastlive),
                                       mk:reg(loopexitcnd),
                                       mk:const(0, mk:v(1))))))));

              // Now, lift the exit condition itself:
              addentry(mk:modentry:wire(mk:v(1), loopexitcnd));
              addentry(mk:modentry:assign(loopexitcnd, exitcnd));
              [mk:stmt:if(mk:op('range', [
                                        mk:reg(thrcount);
                                        mk:const(depth-1, mk:v(32));
                                        mk:const(depth-1, mk:v(32))
                                     ], mk:v(1)),
                          mk:set(isentry, mk:v(mk:const(0, mk:v(1)))),
                          mk:begin([mk:nop()]));
               /*
               mk:stmt:display("ISENTRY=%d LOOP_EXIT_CND=%d THRCOUNT=%d LIVECOUNT=%d THRLIVE=%d", [mk:reg(isentry);mk:reg(loopexitcnd); mk:reg(thrcount); mk:reg(livecnt); mk:reg(thrlive)]);
               @map [nm;tp;init;step] in rregs do {
                  mk:stmt:display(%S<<("LOOP REG ", nm, ":: %d"), [mk:reg(nm)])
               };*/
               mk:stmt:if(mk:op('And',
                                 [mk:e(mk:op('range', [
                                        mk:reg(thrcount);
                                        mk:const(depth-1, mk:v(32));
                                        mk:const(depth-1, mk:v(32))
                                     ], mk:v(1)));
                                  mk:e(mk:op('And', [
                                     mk:e(mk:op('EQ',[mk:reg(livecnt);mk:const(0,mk:v(1))], mk:v(1)));
                                     @if (batchp) [mk:value:e(mk:op('NOT', [mk:e(mk:op('SLT', [mk:reg(issued); count], mk:v(1)))], mk:v(1)))]
                                       else [mk:value:const(1, mk:v(1))]], mk:v(1)))], mk:v(1)),
                          mk:begin([
                                mk:set(isidle, mk:v(mk:const(1, mk:v(1))));
                                /*mk:display("EXIT AT %d", [mk:reg(isentry)]);*/
                                @if (not(onecyclep)) 
                                   [mk:set(ackname, mk:v(mk:const(1, mk:v(1))))]
                                else []
                                ]),
                          mk:begin([mk:nop()]))]};
           // Emit isentry and isidle
           addentry(mk:modentry:register(mk:v(1), isentry));
           addentry(mk:modentry:register(mk:v(1), isidle));

           finalkind(i) = visit:hls2 /rec/ (instr: i) {
              deep instr { a -> 'a' | z -> op };
              deep iop { store -> 'store' | else -> 'other' }};
           finalouts = filter i in final as (finalkind(i) === 'a');
           finalstores = filter i in final as (finalkind(i) === 'store');
           storeparts(i) = visit:hls2 /rec/ (instr: i) {
              deep instr { z -> op | a -> [] };
              deep iop { store -> [mem; offset; v] | else -> [] }};
           renfinal(v) =
              visit:hls2 /rec, dst hls3/ (value: v) {
                 once value {
                   reg -> if (id === idname) mk:reg(thridexit)
                          else aif(chk = ohashget(rregsht, id)) mk:reg(chk) else node()
                 | else -> node()}};
           // Stores in the exit block go to the kernel's own RAMs when the thread finishes; the
           // memory lowering muxes them into the write ports.
           iter s in finalstores do {
             <[mem; off; v]> = storeparts(s);
              symbols(stwe, staddr, stdata) {
                 addentry(mk:modentry:wire(mk:v(1), stwe));
                 addentry(mk:modentry:wire(mk:v(32), staddr));
                 addentry(mk:modentry:wire(mk:v(32), stdata));
                 addentry(mk:modentry:assign(stwe, mk:reg(isoutput)));
                 addentry(mk:modentry:assign(staddr, renfinal(off)));
                 addentry(mk:modentry:assign(stdata, renfinal(v)));
                 ll_hls_enqueue_stores := [mem; stwe; staddr; stdata] : ^ll_hls_enqueue_stores}};
           getoutdefs() =
                collector(add, get) {
                  iter i in finalouts do
                     visit:hls2 /rec/ (instr:i) {
                       deep instr {
                          a -> {
                            println('GODF-A'(outputs, reg));
                            aif(chk = ohashget(outputs, reg))
                               add([reg;chk;op])
                            else ccerror('NON-OUTPUT-ASSIGNMENT-IN-REISSUE'())}
                        | z -> ccerror('ILLEGAL-INSTRUCTION-IN-REISSUE'())};
                       deep value {
                          reg -> {  // If it's a header phi register, we have to refer to its _next value
                                    // here instead.
                            println('GODF-REG'(id));
                            aif(chk = ohashget(rregsht, id)) mk:reg(chk) else node()}
                        | else -> node()};
                       deep iop {
                          v -> v
                        | else -> ccerror('ILLEGAL-INSTRUCTION-IN-REISSUE'())}};
                  return get()};
                  
           // If a single-cycle output protocol is configured - out register
           // is combined with threadid, and ACK is raised as many times as
           // many threads have finished (i.d., exactly the DEPTH number of ACKs)
           onecycleout() = {
              outs = getoutdefs();
              println('OUTDEFS='(outs));
              (map [reg;w;v] in outs do {
                 nextnm = %Sm<<(reg, "_next");
                 thridwidth = 8;
                 addentry(mk:modentry:wire(mk:v(w + thridwidth), nextnm));
                 
                 addentry(mk:modentry:assign(nextnm,
                    mk:e(mk:op('compose', [mk:reg(getreg(thrid));v],
                         mk:v(w + thridwidth)))));
                         
                 mk:stmt:set(reg, mk:v(mk:reg(nextnm)))
              })  :: [
                 mk:stmt:if(mk:v(mk:reg(isoutput)),
                               mk:set(ackname, mk:v(mk:const(1, mk:v(1)))),
                               mk:set(ackname, mk:v(mk:const(0, mk:v(1)))))
              ]
           };

           accumulate() = {
              // Accumulate the current thread output, if:
              //   - entry or thread was alive, but the exit condition failed
              // We're extracting the assignment from the final instructions
              // Only assignments to the ouput registers are allowed there, anything else
              // triggers an error.
              outs = getoutdefs();
              iter [reg;w;v] in outs do {
                 nextnm = %Sm<<(reg, "_next");
                 addentry(mk:modentry:wire(mk:v(w * depth), nextnm));
                 // TODO:
                 wires = map d in [0..depth] do {
                    nm = %S<<(reg, "_thr_", d);
                    rd = (depth - d) - 1;
                    addentry(mk:modentry:wire(mk:v(w), nm));
                    addentry(mk:modentry:assign(nm,
                      mk:e(
                        mk:select(mk:e(mk:op('range', [
                                               mk:reg(thrcount);
                                               mk:const(d, mk:v(32));
                                               mk:const(d, mk:v(32))
                                             ], mk:v(1))),
                                  v,
                                  mk:e(mk:op('range',
                                        [mk:reg(reg);
                                         mk:value:const(rd * w + (w - 1), mk:v(32));
                                         mk:value:const(rd * w, mk:v(32))], mk:v(w)))))));
                    return mk:value:reg(nm)};
                 addentry(mk:modentry:assign(nextnm,
                    mk:e(mk:op('compose',
                         wires, mk:v(w*depth)))))
              };
              [@map [reg;w;v] in outs do
                mk:stmt:if(mk:v(mk:reg(isoutput)),
                   mk:set(reg, mk:v(mk:reg(%Sm<<(reg, "_next")))),
                   mk:begin([mk:nop()]))]};


           // Initial counter register values, reset ACK
           initialise = [
                  mk:stmt:begin([
                     mk:set(thrcount, mk:v(mk:const(1, mk:v(32))));
                     mk:set(isentry, mk:v(mk:const(1, mk:v(32))));
                     mk:set(livecnt, mk:v(mk:const(0, mk:v(32))));
                     mk:set(ackname, mk:v(mk:const(0, mk:v(1))))
                  ])];
           // Wait for the req signal
           waitreq = [
              mk:stmt:if(mk:v(mk:reg(reqname)),
                mk:begin([
                   mk:set(isidle, mk:v(mk:const(0, mk:v(1))));
                   @if (batchp) [mk:stmt:set(nextid, mk:v(thrinit));
                                 mk:stmt:set(issued, mk:v(mk:const(0, i32t)))]
                     else [mk:stmt:set(getreg(thrid), mk:v(thrinit))]
                   ]),
                mk:begin([
                   mk:set(isidle, mk:v(mk:const(1, mk:v(1))))
                   ]))
           ];
           
           loopstage = mk:stmt:begin(
                  // LOOP stage
                  [@increments;
                   @if (onecyclep) onecycleout() else if (dispatchp) [] else accumulate();
                   @checkexit
                  ]);
           // With an initiation interval above one the pipeline registers move only on the last
           // sub-cycle, and so does the thread issue.
           loopstage1 = if (ii > 1)
                           mk:stmt:if(mk:v(mk:reg(advname)), loopstage, mk:begin([mk:nop()]))
                        else loopstage;
           enqueue_fsm =
            mk:stmt:begin([
              @loopregs;
              mk:stmt:if(
                 mk:v(mk:reg(isidle)),
                 mk:stmt:begin(
                  // IDLE stage
                  [@initialise;
                   @waitreq]),
                 loopstage1)]);
             
           a1 = mk:modentry:always(
              mk:if(mk:op('NOT',[mk:reg('reset')], mk:v(32)),
                    enqueue_reset,
                    enqueue_fsm));
           addentry(a1)
        }
      | else -> ccerror('IMPOSSIBLE'())}}}}

\pfcode{
function ll_to_hls_unroll_enqueue(outputs, ee)
collector (addentry, getentries) {
   getreg(v) =
      visit:hls2 /rec/ (value: v) {
        once value {
          reg -> id
        | else -> ccerror('NOPE'())}};
   visit:hls2 /rec, dst hls3/ (specentry: ee) {
      once specentry {
        enqueue_loop -> ll_to_hls_unroll_enqueue_loop(addentry, outputs, ee, onecyclep)
      | enqueue_once ->
          xsymbols(isidle, isissue, isassemble,
                  issuecount, acccount, nextthrid,
                  nextissuecount) {
           enqueue_reset =
              mk:stmt:begin(
                ss = [
                   mk:set(issuecount, mk:v(mk:const(0, mk:v(32))));
                   mk:set(acccount, mk:v(mk:const(0, mk:v(32))));
                   mk:set(getreg(thrid), mk:v(mk:const(0, mk:v(32))));
                   mk:set('ACK', mk:v(mk:const(0, mk:v(1))));
                   @{
                     map a in accum_dst do {
                      mk:set(getreg(a), mk:v(mk:const(0, mk:v(32))))}}
                ]);
           addentry(mk:modentry:register(mk:v(32), getreg(thrid)));  // TODO: type!
           addentry(mk:modentry:register(mk:v(32), issuecount));
           addentry(mk:modentry:register(mk:v(32), acccount));
           addentry(mk:modentry:wire(mk:v(1), isidle));
           addentry(mk:modentry:wire(mk:v(1), isissue));
           addentry(mk:modentry:wire(mk:v(1), isassemble));
           addentry(mk:modentry:wire(mk:v(32), nextthrid)); // TODO: type!
           addentry(mk:modentry:wire(mk:v(32), nextissuecount));

           addentry(mk:modentry:assign(nextissuecount,
               mk:e(mk:op('Add', [mk:reg(issuecount); mk:const(1, mk:v(32))], mk:v(32)))));
           addentry(mk:modentry:assign(nextthrid,
               mk:e(mk:op('Add', [thrid; step], mk:v(32))))); // TODO: type!
 
           addentry(mk:modentry:assign(isidle,
               mk:e(
                 mk:op('Or', [
                   mk:e(mk:op('EQ', [mk:reg(issuecount); mk:const(0, mk:v(32))], mk:v(1)));
                   mk:reg('ACK')], mk:v(1)))));
           addentry(mk:modentry:assign(isissue,
               mk:e(
                 mk:op('SLT', [
                    mk:reg(issuecount);
                    mk:const(depth+1, mk:v(32))], mk:v(1)))));
           addentry(mk:modentry:assign(isassemble,
               mk:e(
                 mk:op('And', [
                    mk:e(mk:op('EQ', [mk:reg(issuecount); mk:const(depth+1, mk:v(32))], mk:v(1)));
                    mk:e(mk:op('SLT', [mk:reg(acccount); mk:const(depth+1, mk:v(32))], mk:v(1)))],
                    mk:v(1)))));

           iter [a;src] in zip(accum_dst, accum_src) do {
              accnm = %Sm<<(getreg(a), "_collect");
              dstwidth = ohashget(outputs, getreg(a));
              addentry(mk:modentry:wire(mk:v(depth * dstwidth), accnm));
              addentry(mk:modentry:assign(accnm,
                       mk:e(mk:op('compose',
                              reverse(map thread in [0..depth] do {
                                 cnd = mk:value:e(
                                    mk:op('EQ', [mk:reg(acccount);
                                                 mk:const(thread + 1, mk:v(32))],
                                          mk:v(1)));
                                 mk:value:e(mk:select(cnd, src,
                                      mk:e(mk:op('range',
                                            [a; mk:value:const(thread * dstwidth + dstwidth - 1, mk:v(32));
                                                mk:value:const(thread * dstwidth, mk:v(32))],
                                            mk:v(dstwidth)))))
                              }), mk:v(depth*dstwidth)))))};
           
           enqueue_fsm =
              mk:stmt:if(
                mk:v(mk:reg(isidle)),
                mk:stmt:begin(
                  ss = [
                     mk:set('ACK', mk:v(mk:const(0, mk:v(1))));
                     mk:if(mk:v(mk:reg('REQ')),
                           mk:stmt:begin(
                             ss = [
                                mk:set(issuecount, mk:v(mk:const(1, mk:v(32))));
                                mk:set(acccount, mk:v(mk:const(1, mk:v(32))));
                                mk:set(getreg(thrid), mk:v(thrinit))
                             ]),
                           mk:stmt:begin( ss= [
                              mk:set(issuecount, mk:v(mk:const(0, mk:v(32))))]))
                
                  ]),
                mk:stmt:if(
                   mk:v(mk:reg(isissue)),
                   mk:stmt:begin( // Thread issue process
                      ss = [
                         mk:set(getreg(thrid), mk:v(mk:reg(nextthrid)));
                         mk:set(issuecount, mk:v(mk:reg(nextissuecount)))
                      ]),
                   mk:stmt:begin(
                     ss = [
                       @map a in accum_dst do
                          mk:set(getreg(a), mk:v(mk:reg(%Sm<<(getreg(a), "_collect"))));
                       mk:stmt:if(
                         mk:v(mk:reg(isassemble)),
                         mk:stmt:begin(
                           ss = [ // Thread assembly process
                             mk:set(acccount, mk:op('Add', [mk:reg(acccount); mk:const(1, mk:v(32))], mk:v(32)))
                           ]),
                          mk:stmt:begin( // Assembled, set ACK and go to idle
                            ss = [
                               mk:set('ACK', mk:v(mk:const(1, mk:v(1))))
                            ])
                        )])));
                     
           a1 = mk:modentry:always(
              mk:if(mk:op('NOT',[mk:reg('reset')], mk:v(32)),
                    enqueue_reset,
                    enqueue_fsm));
           addentry(a1)}
      | else -> ccerror('TODO'())}};
   return getentries()}}

%%%%%%
